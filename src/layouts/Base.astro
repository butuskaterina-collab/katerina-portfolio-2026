---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  path?: string;
  title?: string;
  description?: string;
}
const props = Astro.props;
const { lang, path = '/' } = props;
// в <title> и описании невидимые склейки типографа не нужны: вкладки и поисковики показывают их пробелами
const plain = (v: string) => v.replace(/\u2060/g, '').replace(/\u00a0/g, ' ');
const title = plain(props.title ?? t(lang, 'meta.title'));
const description = plain(props.description ?? t(lang, 'meta.description'));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eef0ef" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang="ru" href={new URL(path, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(`/en${path}`, Astro.site)} />
  </head>
  <body>
    <div class="guides grid" aria-hidden="true">
      {Array.from({ length: 12 }, () => <span />)}
    </div>
    <Header lang={lang} path={path} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      import { initScramble } from '../scripts/scramble';
      import { initClocks } from '../scripts/clocks';
      initScramble();
      initClocks();

      // G — показать/скрыть сетку (для проверки вёрстки)
      document.addEventListener('keydown', (e) => {
        if (e.key.toLowerCase() !== 'g' && e.key.toLowerCase() !== 'п') return;
        if ((e.target as HTMLElement).closest('input, textarea')) return;
        document.documentElement.classList.toggle('show-grid');
      });
    </script>
  </body>
</html>
