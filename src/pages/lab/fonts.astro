---
// Временная страница для выбора шрифтов. После решения — удалить вместе с лишними пакетами.
import '../../styles/global.css';
import '@fontsource-variable/cormorant-garamond/wght.css';
import '@fontsource-variable/playfair/opsz.css';
import '@fontsource-variable/noto-serif-display/wght.css';
import '@fontsource-variable/literata/opsz.css';
import '@fontsource-variable/brygada-1918/wght.css';
import '@fontsource/spectral/300.css';
import '@fontsource/prata/400.css';
import '@fontsource/old-standard-tt/400.css';
import '@fontsource/bona-nova/400.css';
import '@fontsource/oranienbaum/400.css';

const serifs = [
  { id: 'cormorant', name: 'Cormorant Garamond (сейчас)', family: "'Cormorant Garamond Variable'", weight: 400, lh: 0.86, note: 'гарнитура в духе Гарамона, длинные выносные' },
  { id: 'playfair', name: 'Playfair 2', family: "'Playfair Variable'", weight: 400, lh: 0.94, note: 'высокий контраст, «модная» дидона, оптические размеры' },
  { id: 'noto', name: 'Noto Serif Display', family: "'Noto Serif Display Variable'", weight: 300, lh: 0.94, note: 'острая, контрастная, светлое начертание' },
  { id: 'spectral', name: 'Spectral Light', family: "'Spectral'", weight: 300, lh: 0.94, note: 'спокойная, лёгкая, экранная антиква' },
  { id: 'literata', name: 'Literata', family: "'Literata Variable'", weight: 300, lh: 0.94, note: 'книжная, с тёплой кириллицей' },
  { id: 'prata', name: 'Prata', family: "'Prata'", weight: 400, lh: 0.94, note: 'дидона от Cyreal, кириллица родная' },
  { id: 'oldstandard', name: 'Old Standard TT', family: "'Old Standard TT'", weight: 400, lh: 0.94, note: '«обыкновенная новая» — русская книжная печать XIX века, архив' },
  { id: 'oranienbaum', name: 'Oranienbaum', family: "'Oranienbaum'", weight: 400, lh: 0.94, note: 'узкая контрастная акцидентная, русский шрифтовик' },
  { id: 'bona', name: 'Bona Nova', family: "'Bona Nova'", weight: 400, lh: 0.94, note: 'польская антиква, своеобразные формы' },
  { id: 'brygada', name: 'Brygada 1918', family: "'Brygada 1918 Variable'", weight: 400, lh: 0.94, note: 'шрифт 1918 года, немного угловатый' },
];

const roles = [
  { id: 'sans', name: 'Гротеск, обычный, прописные' },
  { id: 'sans-light', name: 'Гротеск, светлый, строчные, крупнее' },
  { id: 'mono', name: 'Моноширинный, как подписи' },
  { id: 'condensed', name: 'Узкий гротеск, обычный вес' },
  { id: 'heavy', name: 'Как сейчас (жирный узкий)' },
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Лаборатория шрифтов</title>
  </head>
  <body data-serif="cormorant" data-role="sans" data-lang="ru">
    <div class="guides grid" aria-hidden="true">{Array.from({ length: 12 }, () => <span />)}</div>

    <section class="hero grid">
      <div class="name-block">
        <p class="line line-1"><span class="ru">Катерина</span><span class="en">Katerina</span></p>
        <p class="line line-2"><span class="ru">Бутусова</span><span class="en">Butusova</span></p>
        <p class="role"><span class="ru">коммуникационный дизайнер</span><span class="en">communication designer</span></p>
      </div>
      <p class="lead">
        <span class="ru">Работаю на пересечении графического дизайна, визуальных исследований, айдентики, моушена и цифровых медиа.</span>
        <span class="en">Working at the intersection of graphic design, visual research, identity, motion and digital media.</span>
      </p>
      <p class="alphabet">
        АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ<br />абвгдеёжзийклмнопрстуфхцчшщъыьэюя<br />Aa Bb Cc Kk Rr — 2026
      </p>
    </section>

    <aside class="panel mono">
      <fieldset>
        <legend>Имя</legend>
        {
          serifs.map((s) => (
            <label>
              <input type="radio" name="serif" value={s.id} checked={s.id === 'cormorant'} />
              <span>{s.name}</span>
              <span class="muted note">{s.note}</span>
            </label>
          ))
        }
      </fieldset>
      <fieldset>
        <legend>Подпись «дизайнер»</legend>
        {
          roles.map((r) => (
            <label>
              <input type="radio" name="role" value={r.id} checked={r.id === 'sans'} />
              <span>{r.name}</span>
            </label>
          ))
        }
      </fieldset>
      <fieldset>
        <legend>Язык</legend>
        <label><input type="radio" name="lang" value="ru" checked /> <span>RU</span></label>
        <label><input type="radio" name="lang" value="en" /> <span>EN</span></label>
      </fieldset>
    </aside>

    <style is:global>
      .ru, .en { display: none; }
      body[data-lang='ru'] .ru, body[data-lang='en'] .en { display: inline; }
    </style>

    <style>
      .hero {
        padding-top: var(--s6);
        padding-right: calc(var(--margin) + 300px);
      }
      .name-block {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: subgrid;
      }
      .line {
        font-family: var(--name-family);
        font-weight: var(--name-weight);
        font-size: clamp(64px, 12vw, 260px);
        line-height: var(--name-lh);
        letter-spacing: -0.02em;
        white-space: nowrap;
      }
      .line-1 { grid-column: 1 / -1; grid-row: 1; }
      .line-2 { grid-column: 4 / -1; grid-row: 2; }
      .role {
        grid-column: 10 / -1;
        grid-row: 1;
        align-self: end;
        padding-bottom: 1vw;
      }
      .lead {
        grid-column: 4 / span 5;
        margin-top: var(--s5);
      }
      .alphabet {
        grid-column: 1 / -1;
        margin-top: var(--s6);
        font-family: var(--name-family);
        font-weight: var(--name-weight);
        font-size: 36px;
        line-height: 1.25;
      }

      /* варианты подписи */
      body[data-role='sans'] .role { font: 500 13px/16px var(--f-sans); letter-spacing: 0.06em; text-transform: uppercase; }
      body[data-role='sans-light'] .role { font: 300 clamp(18px, 1.7vw, 30px)/1.05 var(--f-sans); letter-spacing: -0.01em; }
      body[data-role='mono'] .role { font: 400 11px/16px var(--f-mono); letter-spacing: 0.02em; text-transform: uppercase; }
      body[data-role='condensed'] .role { font: 400 clamp(20px, 1.9vw, 34px)/0.95 var(--f-display); text-transform: uppercase; }
      body[data-role='heavy'] .role { font: 800 clamp(26px, 2.85vw, 56px)/0.88 var(--f-display); text-transform: uppercase; }

      .panel {
        position: fixed;
        top: var(--s2);
        right: var(--s2);
        bottom: var(--s2);
        width: 300px;
        overflow: auto;
        padding: var(--s2);
        background: rgba(238, 240, 239, 0.92);
        border: 1px solid var(--hair);
        backdrop-filter: blur(6px);
        z-index: 50;
      }
      fieldset { border: 0; padding: 0; margin: 0 0 var(--s3); }
      legend { margin-bottom: var(--s1); color: var(--grey); }
      label { display: grid; grid-template-columns: 16px 1fr; column-gap: 6px; padding: 4px 0; cursor: pointer; }
      .note { grid-column: 2; text-transform: none; font-size: 10px; line-height: 13px; }

      @media (max-width: 800px) {
        .hero { padding-right: var(--margin); padding-bottom: 60vh; }
        .panel { top: auto; left: var(--s1); right: var(--s1); bottom: var(--s1); width: auto; height: 50vh; }
        .role { grid-column: 2 / -1; grid-row: 3; margin-top: var(--s2); }
        .line-2 { grid-column: 2 / -1; }
        .lead { grid-column: 1 / -1; }
      }
    </style>

    <script define:vars={{ serifs }}>
      const body = document.body;
      const apply = () => {
        const s = serifs.find((f) => f.id === body.dataset.serif);
        body.style.setProperty('--name-family', s.family);
        body.style.setProperty('--name-weight', s.weight);
        body.style.setProperty('--name-lh', s.lh);
      };
      document.querySelectorAll('input[type=radio]').forEach((input) => {
        input.addEventListener('change', () => {
          body.dataset[input.name] = input.value;
          apply();
        });
      });
      apply();
    </script>
  </body>
</html>
