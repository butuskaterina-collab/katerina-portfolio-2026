---
import { t, localePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  path?: string; // путь текущей страницы без языкового префикса — для переключателя
}
const { lang, path = '/' } = Astro.props;

const nav = [
  { key: 'nav.projects', href: '/projects/' },
  { key: 'nav.archive', href: '/archive/' },
  { key: 'nav.texts', href: '/texts/' },
  { key: 'nav.about', href: '/about/' },
  { key: 'nav.cv', href: '/cv/' },
] as const;

// деления линейки: метки по колонкам сетки
const marks = Array.from({ length: 13 }, (_, i) => i * 100);
---

<header class="header">
  <div class="ruler" aria-hidden="true">
    {marks.map((m, i) => <span class="mark" style={`left:${(i / 12) * 100}%`}>{m}</span>)}
  </div>

  <nav class="bar grid mono" aria-label={lang === 'ru' ? 'Основная навигация' : 'Main navigation'}>
    <a class="home" href={localePath(lang, '/')}>
      <span data-scramble>К.Б.</span><span class="muted">/2026</span>
    </a>
    <ul class="links">
      {
        nav.map((item, i) => (
          <li style={`--col:${i + 4}`}>
            <a href={localePath(lang, item.href)}>
              <span class="num muted">{String(i + 1).padStart(2, '0')}</span>
              <span data-scramble>{t(lang, item.key)}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="lang">
      <a href={localePath('ru', path)} aria-current={lang === 'ru' ? 'true' : undefined} lang="ru">RU</a>
      <span class="muted">/</span>
      <a href={localePath('en', path)} aria-current={lang === 'en' ? 'true' : undefined} lang="en">EN</a>
    </div>
  </nav>
</header>

<style>
  .header {
    position: relative;
    z-index: 10;
    padding: 0; /* поля задаёт сетка страницы, а не общий отступ header из ids/layout.css */
  }

  .ruler {
    position: relative;
    height: var(--ids__spacer-s);
    margin-inline: var(--page-margin);
    border-bottom: var(--ids__border-width-s) solid var(--ids__border);
    /* мелкие деления — шагом gap-s, крупные — шагом spacer-m; растут вместе со страницей */
    background:
      repeating-linear-gradient(to right, var(--ids__border) 0 var(--ids__border-width-s), transparent var(--ids__border-width-s) var(--ids__spacer-m)) bottom / 100% var(--ids__gap-s) no-repeat,
      repeating-linear-gradient(to right, var(--ids__border) 0 var(--ids__border-width-s), transparent var(--ids__border-width-s) var(--ids__gap-s)) bottom / 100% calc(var(--ids__gap-s) / 2) no-repeat;
  }

  .mark {
    position: absolute;
    top: 0;
    transform: translateX(0.4em);
    font-family: var(--f-mono);
    font-size: 0.4rem;
    line-height: 1;
    color: var(--ids__text-caption);
  }

  /* последняя метка стоит у правого поля — подписываем её слева от деления */
  .mark:last-child {
    transform: translateX(calc(-100% - 0.4em));
  }

  .bar {
    padding-block: var(--ids__spacer-s);
  }

  .home {
    grid-column: 1 / span 3;
  }

  /* каждый пункт меню начинается со своей колонки: 4, 5, 6, 7, 8 */
  .links {
    display: contents;
    list-style: none;
  }

  .links li {
    grid-column: var(--col) / span 1;
    white-space: nowrap;
  }

  .links a {
    display: inline-flex;
    gap: 0.5em;
    transition: opacity var(--ids__duration-base) var(--ids__easing-base);
  }

  .bar:has(.links a:hover) .links a:not(:hover) {
    opacity: 0.35;
    transition-duration: var(--ids__duration-instant);
  }

  .lang {
    grid-column: 12 / span 1;
    justify-self: end;
    display: flex;
    gap: 0.35em;
  }

  .lang a:not([aria-current]) {
    color: var(--ids__text-caption);
  }

  .lang a:hover {
    color: var(--ids__text);
  }

  @media (width < 768px) {
    .num {
      display: none;
    }
    /* на узком экране метки линейки через одну, иначе слипаются */
    .mark:nth-child(even) {
      display: none;
    }
    .bar {
      row-gap: var(--ids__spacer-s);
    }
    .home {
      grid-column: 1 / span 3;
    }
    .lang {
      grid-column: 6 / span 1;
    }
    /* на телефоне меню — второй строкой, по две колонки на пункт */
    .links li {
      grid-row: 2;
      grid-column: auto / span 1;
    }
    .links li:nth-child(n + 4) {
      grid-row: 3;
    }
    .links li:nth-child(1),
    .links li:nth-child(4) {
      grid-column: 1 / span 2;
    }
    .links li:nth-child(2),
    .links li:nth-child(5) {
      grid-column: 3 / span 2;
    }
    .links li:nth-child(3) {
      grid-column: 5 / span 2;
    }
  }
</style>
