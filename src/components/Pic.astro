---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/* Картинка проекта: JPG/PNG — через оптимизацию Astro (WebP нужных ширин),
   GIF — как есть, иначе от анимации останется первый кадр. */
interface Props {
  src: ImageMetadata;
  alt?: string;
  sizes: string;
  eager?: boolean;
  class?: string;
}
const { src, alt = '', sizes, eager = false, class: cls } = Astro.props;
const widths = [720, 1080, 1440, 2160, 2880].filter((w) => w <= src.width);
---

{
  src.format === 'gif' ? (
    <img class={cls} src={src.src} width={src.width} height={src.height} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  ) : (
    <Image
      class={cls}
      src={src}
      alt={alt}
      widths={widths.length ? widths : [src.width]}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
    />
  )
}
