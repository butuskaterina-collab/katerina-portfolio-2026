---
import Pic from './Pic.astro';
import { t, localePath, type Lang } from '../i18n/ui';
import { getProjects } from '../lib/projects';
import { selected } from '../data/selected';
import { typograph } from '../lib/typograph';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// готовые кейсы из коллекции + остальные из избранного (без визуальных исследований — они в «Текстах»),
// у которых страницы пока нет: показываем их обложкой с пометкой «скоро»
const ready = await getProjects(lang, 'projects');
const readySlugs = new Set(ready.map((p) => p.slug));
const research = ['визуальное исследование'];
const cards = [
  ...ready.map((p) => ({ slug: p.slug, title: p.title, type: p.type, year: p.year, cover: p.cover, href: localePath(lang, `/projects/${p.slug}/`) })),
  ...selected
    .filter((s) => !readySlugs.has(s.slug) && !research.includes(s.type.ru))
    .map((s) => ({ slug: s.slug, title: typograph(s.title[lang]), type: s.type[lang], year: s.year, cover: s.cover, href: undefined })),
];
import '../styles/page-head.css';
---

<!--
  Вкладка «Проекты» — не список, как на главной (список будет в архиве), а лист контактов:
  обложки в три колонки по 4 колонки сетки, средняя колонка опущена — контролируемый сдвиг.
-->
<section class="projects">
  <header class="page-head grid">
    <h1 class="page-title">{t(lang, 'projects.title')} <span class="page-count mono muted">({String(cards.length).padStart(2, '0')})</span></h1>
    <p class="page-lead">{t(lang, 'projects.lead')}</p>
  </header>

  <ol class="cards grid">
    {
      cards.map((c, i) => {
        const Tag = c.href ? 'a' : 'div';
        return (
          <li class="card" style={`--i:${i % 3}`}>
            <Tag class:list={['card-link', { soon: !c.href }]} href={c.href}>
              <figure class="card-cover">{c.cover && <Pic src={c.cover} sizes="(width < 768px) 100vw, 33vw" eager={i < 3} />}</figure>
              <p class="card-meta mono">
                <span class="muted">{String(i + 1).padStart(3, '0')}</span>
                <span>{c.type}</span>
                <span>{c.href ? c.year : t(lang, 'projects.soon')}</span>
              </p>
              <h2 class="card-title" data-scramble={c.href ? '' : undefined}>{c.title}</h2>
            </Tag>
          </li>
        );
      })
    }
  </ol>
</section>

<style>




  .cards {
    margin: var(--ids__spacer-xl) 0 0;
    list-style: none;
    row-gap: var(--ids__spacer-l);
    align-items: start;
  }

  .card {
    grid-column: span 4;
  }

  /* средняя колонка листа опущена на полшага — сетка остаётся, ритм сбивается */
  .card[style*='--i:1'] {
    margin-top: var(--ids__spacer-xl);
  }

  .card-link {
    display: block;
    transition: opacity var(--ids__duration-base) var(--ids__easing-base);
  }

  .cards:has(a.card-link:hover) .card-link:not(:hover) {
    opacity: 0.35;
    transition-duration: var(--ids__duration-instant);
  }

  .card-cover {
    margin: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--ids__surface);
  }

  .card-cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .soon .card-cover :global(img) {
    filter: grayscale(1);
    opacity: 0.45;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    gap: var(--ids__gap-m);
    margin-top: var(--ids__gap-s);
    padding-bottom: var(--ids__gap-s);
    border-bottom: var(--ids__border-width-s) solid var(--ids__border);
  }

  .card-title {
    margin: var(--ids__gap-s) 0 0;
    font-size: 1.5rem; /* кегль h3 в IDS, как строки на главной */
    font-weight: 400;
    line-height: calc(var(--ids__density) / 1.1);
    letter-spacing: -0.015em;
  }

  .soon .card-title {
    color: var(--ids__text-caption);
  }

  @media (width < 768px) {
    .cards {
      margin-top: var(--ids__spacer-l);
    }
    /* на телефоне — одна колонка, карточки чуть смещаются влево-вправо */
    .card {
      grid-column: 1 / span 5;
    }
    .card:nth-child(even) {
      grid-column: 2 / span 5;
    }
    .card[style*='--i:1'] {
      margin-top: 0;
    }
  }
</style>
