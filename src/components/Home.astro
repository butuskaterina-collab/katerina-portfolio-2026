---
import { Image } from 'astro:assets';
import { t, localePath, type Lang } from '../i18n/ui';
import { selected } from '../data/selected';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const cities = [
  { key: 'city.yakutsk', zone: 'Asia/Yakutsk', utc: '+09', coords: '62.0355° N 129.6755° E' },
  { key: 'city.spb', zone: 'Europe/Moscow', utc: '+03', coords: '59.9343° N 30.3351° E' },
] as const;

const ARCHIVE_TOTAL = 32;
---

<!--
  Сетка главной: 12 колонок. Главная вертикальная ось — начало 4-й колонки:
  с неё начинаются меню, часы, фамилия, описание и названия проектов.
  Вторая ось — 10-я колонка: школа, «дизайнер», заметка, типы проектов.
-->

<section class="hero grid" aria-labelledby="name">
  <span class="reg reg-tl" aria-hidden="true"></span>
  <span class="reg reg-br" aria-hidden="true"></span>

  <p class="meta mono">
    <span class="muted">Portfolio</span><br />
    2023 — 2026<br />
    <span class="muted">v 0.3 / draft</span>
  </p>

  {
    cities.map((c, i) => (
      <p class="clock mono" style={`--col:${4 + i * 3}`}>
        {t(lang, c.key)}
        <br />
        <span class="muted">{c.coords}</span>
        <br />
        <time data-clock={c.zone}>--:--:--</time> <span class="muted">UTC{c.utc}</span>
      </p>
    ))
  }

  <p class="school mono muted">{t(lang, 'hero.school')}</p>

  <div class="name-block">
    <h1 id="name" class="name">
      <span class="line line-1">{t(lang, 'name.first')}</span>
      <span class="line line-2">{t(lang, 'name.last')}</span>
    </h1>
    <p class="role mono">{t(lang, 'hero.role')}</p>
  </div>

  <p class="lead">
    {t(lang, 'hero.lead.before')}<em class="serif">{t(lang, 'hero.lead.accent')}</em>{t(lang, 'hero.lead.after')}
  </p>

  <p class="note mono">{t(lang, 'hero.note')}</p>
</section>

<section class="index" aria-labelledby="index-title">
  <div class="index-head grid mono">
    <h2 id="index-title">{t(lang, 'index.title')} <span class="muted">({String(selected.length).padStart(2, '0')})</span></h2>
    <a class="all" href={localePath(lang, '/archive/')}>
      <span data-scramble>{t(lang, 'index.all')}</span> <span class="muted">({ARCHIVE_TOTAL})</span> →
    </a>
  </div>

  <ol class="rows">
    {
      selected.map((p, i) => (
        <li>
          <a class="row grid" href={localePath(lang, `/projects/${p.slug}/`)}>
            <span class="r-num mono muted">{String(i + 1).padStart(3, '0')}</span>
            <span class="r-title" data-scramble>{p.title[lang]}</span>
            <span class="r-type mono">{p.type[lang]}</span>
            <span class="r-year mono">{p.year}</span>
            <Image class="r-preview" src={p.cover} alt="" width={720} widths={[360, 720]} sizes="340px" loading="lazy" />
          </a>
        </li>
      ))
    }
  </ol>
</section>

<script>
  // превью проекта следует за курсором; угол наклона у каждого свой — небольшой беспорядок
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  if (fine) {
    document.querySelectorAll<HTMLElement>('.row').forEach((row) => {
      const img = row.querySelector<HTMLElement>('.r-preview');
      if (!img) return;
      img.style.setProperty('--tilt', `${(Math.random() * 6 - 3).toFixed(2)}deg`);
      row.addEventListener('mousemove', (e) => {
        img.style.setProperty('--x', `${e.clientX}px`);
        img.style.setProperty('--y', `${e.clientY}px`);
      });
    });
  }
</script>

<style>
  /* ——— первый экран ——— */
  .hero {
    position: relative;
    min-height: calc(100svh - var(--page-header-height));
    grid-template-rows: auto 1fr auto auto;
    padding-top: var(--ids__spacer-l);
    padding-bottom: var(--ids__spacer-l);
  }

  .meta {
    grid-column: 1 / span 3;
  }

  .clock {
    grid-column: var(--col) / span 3;
  }

  .clock time {
    font-variant-numeric: tabular-nums;
  }

  .school {
    grid-column: 10 / span 3;
  }

  /* имя: антиква, статично. Фамилия начинается с главной оси (4-я колонка) */
  .name-block {
    grid-column: 1 / -1;
    grid-row: 3;
    display: grid;
    grid-template-columns: subgrid;
    margin-top: var(--ids__spacer-l);
  }

  .name {
    display: contents;
  }

  /* кегль считается от ширины поля набора: «Катерина» заканчивается до 10-й колонки,
     «Бутусова» от 4-й колонки умещается до правого поля (Old Standard ≈ 4.1em на слово) */
  .line {
    font-family: var(--f-serif);
    font-weight: 400;
    font-size: min(calc((100vw - 2 * var(--page-margin)) * 0.178), 15rem); /* после 1500 px растёт только поле, как у IDS */
    line-height: 0.9;
    letter-spacing: -0.02em;
  }

  .line-1 {
    grid-column: 1 / -1;
    grid-row: 1;
    align-self: last baseline;
  }

  .line-2 {
    grid-column: 4 / -1;
    grid-row: 2;
  }

  /* «дизайнер»: моноширинный, как остальные технические подписи; стоит на линии шрифта имени */
  .role {
    grid-column: 10 / -1;
    grid-row: 1;
    align-self: last baseline;
  }

  .lead {
    grid-column: 4 / span 4;
    grid-row: 4;
    margin-top: var(--ids__spacer-l);
  }

  .lead em {
    font-size: 1.04em;
    line-height: 1;
  }

  /* заметка «на полях»: стоит на второй оси, но чуть повёрнута */
  .note {
    grid-column: 10 / span 3;
    grid-row: 4;
    align-self: end;
    color: var(--ids__text-secondary);
    transform: rotate(-1.5deg);
    transform-origin: left bottom;
  }

  .reg {
    position: absolute;
    width: var(--ids__spacer-s);
    height: var(--ids__spacer-s);
    pointer-events: none;
  }

  .reg::before,
  .reg::after {
    content: '';
    position: absolute;
    background: var(--ids__text);
  }

  .reg::before {
    left: 50%;
    top: 0;
    width: var(--ids__border-width-s);
    height: 100%;
  }

  .reg::after {
    top: 50%;
    left: 0;
    height: var(--ids__border-width-s);
    width: 100%;
  }

  .reg-tl {
    top: var(--ids__gap-l);
    left: calc(var(--page-margin) - var(--ids__spacer-s) / 2);
  }

  .reg-br {
    bottom: var(--ids__gap-l);
    right: calc(var(--page-margin) - var(--ids__spacer-s) / 2);
  }

  /* ——— избранное ——— */
  .index {
    margin-top: var(--ids__spacer-xl);
  }

  .index-head {
    padding-bottom: var(--ids__gap-s);
  }

  .index-head h2 {
    grid-column: 1 / span 3;
    margin: 0;
    font: inherit;
  }

  .all {
    grid-column: 10 / span 3;
  }

  .all:hover [data-scramble] {
    border-bottom: var(--ids__border-width-s) solid var(--ids__text);
  }

  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--ids__border-width-s) solid var(--ids__text);
  }

  .rows li {
    border-bottom: var(--ids__border-width-s) solid var(--ids__border);
  }

  .row {
    align-items: baseline;
    padding-block: var(--ids__spacer-s);
    transition: background-color var(--ids__duration-base) var(--ids__easing-base);
  }

  .r-num {
    grid-column: 1 / span 3;
  }

  .r-title {
    grid-column: 4 / span 6;
    font-size: 1.5rem; /* кегль h3 в IDS */
    line-height: calc(var(--ids__density) / 1.1);
    letter-spacing: -0.015em;
    transition: transform var(--ids__duration-base) var(--ids__easing-base);
  }

  .r-type {
    grid-column: 10 / span 2;
    color: var(--ids__text-secondary);
  }

  .r-year {
    grid-column: 12 / span 1;
    justify-self: end;
  }

  .row:hover {
    background-color: var(--ids__surface);
    transition-duration: var(--ids__duration-instant);
  }

  .row:hover .r-title {
    transform: translateX(var(--ids__spacer-s));
    transition-duration: var(--ids__duration-instant);
  }

  .r-preview {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 20;
    width: 15rem;
    height: auto;
    pointer-events: none;
    opacity: 0;
    transform: translate(calc(var(--x, 0px) + var(--ids__gap-l)), calc(var(--y, 0px) - 50%)) rotate(var(--tilt, 0deg));
    transition: opacity var(--ids__duration-base) var(--ids__easing-base);
    box-shadow: 0 var(--ids__spacer-s) var(--ids__spacer-m) calc(-1 * var(--ids__gap-l)) color-mix(in srgb, var(--ids__color-black) 35%, transparent);
  }

  .row:hover .r-preview {
    opacity: 1;
    transition-duration: var(--ids__duration-instant);
  }

  @media (hover: none), (pointer: coarse) {
    .r-preview {
      display: none;
    }
  }

  /* ——— телефон: 6 колонок, ось — 2-я колонка ——— */
  @media (width < 768px) {
    .reg-tl {
      top: var(--ids__gap-s);
    }
    .hero {
      min-height: auto;
      grid-template-rows: auto;
      row-gap: var(--ids__gap-l);
      padding-top: var(--ids__spacer-m);
    }
    .meta {
      grid-column: 1 / span 3;
    }
    .school {
      grid-column: 4 / span 3;
      grid-row: 1;
    }
    .clock {
      grid-column: auto / span 3;
      grid-row: 2;
    }
    .clock:first-of-type {
      grid-column: 1 / span 3;
    }
    .name-block {
      grid-row: auto;
      margin-top: var(--ids__spacer-m);
    }
    .line {
      font-size: calc((100vw - 2 * var(--page-margin)) * 0.205);
    }
    .line-2 {
      grid-column: 2 / -1;
    }
    .role {
      grid-column: 2 / -1;
      grid-row: 3;
      align-self: start;
      margin-top: var(--ids__spacer-s);
    }
    .lead {
      grid-column: 1 / -1;
      grid-row: auto;
      margin-top: var(--ids__spacer-s);
    }
    .note {
      grid-column: 2 / -1;
      grid-row: auto;
    }
    .index {
      margin-top: var(--ids__spacer-l);
    }
    .index-head h2 {
      grid-column: 1 / span 3;
    }
    .all {
      grid-column: 1 / -1;
    }
    .r-num {
      grid-column: 1 / span 1;
    }
    .r-title {
      grid-column: 2 / -1;
    }
    .r-type {
      grid-column: 2 / span 4;
      margin-top: var(--ids__gap-s);
    }
    .r-year {
      grid-column: 6 / span 1;
    }
    .row:hover .r-title {
      transform: none;
    }
  }
</style>
