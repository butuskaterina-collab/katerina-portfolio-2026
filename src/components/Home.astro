---
import { Image } from 'astro:assets';
import { t, localePath, type Lang } from '../i18n/ui';
import { selected } from '../data/selected';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const cities = [
  { key: 'city.yakutsk', zone: 'Asia/Yakutsk', utc: '+09', coords: '62.0355° N 129.6755° E' },
  { key: 'city.spb', zone: 'Europe/Moscow', utc: '+03', coords: '59.9343° N 30.3351° E' },
] as const;

const ARCHIVE_TOTAL = 32;
---

<!--
  Сетка главной: 12 колонок. Главная вертикальная ось — начало 4-й колонки:
  с неё начинаются меню, часы, фамилия, описание и названия проектов.
  Вторая ось — 10-я колонка: школа, «дизайнер», заметка, типы проектов.
-->

<section class="hero grid" aria-labelledby="name">
  <span class="reg reg-tl" aria-hidden="true"></span>
  <span class="reg reg-br" aria-hidden="true"></span>

  <p class="meta mono">
    <span class="muted">Portfolio</span><br />
    2023 — 2026<br />
    <span class="muted">v 0.2 / draft</span>
  </p>

  {
    cities.map((c, i) => (
      <p class="clock mono" style={`--col:${4 + i * 3}`}>
        {t(lang, c.key)}
        <br />
        <span class="muted">{c.coords}</span>
        <br />
        <time data-clock={c.zone}>--:--:--</time> <span class="muted">UTC{c.utc}</span>
      </p>
    ))
  }

  <p class="school mono muted">{t(lang, 'hero.school')}</p>

  <div class="name-block">
    <h1 id="name" class="name">
      <span class="line line-1">{t(lang, 'name.first')}</span>
      <span class="line line-2">{t(lang, 'name.last')}</span>
    </h1>
    <p class="role">{t(lang, 'hero.role')}</p>
  </div>

  <p class="lead">
    {t(lang, 'hero.lead.before')}<em class="serif">{t(lang, 'hero.lead.accent')}</em>{t(lang, 'hero.lead.after')}
  </p>

  <p class="note mono">{t(lang, 'hero.note')}</p>
</section>

<section class="index" aria-labelledby="index-title">
  <div class="index-head grid mono">
    <h2 id="index-title">{t(lang, 'index.title')} <span class="muted">({String(selected.length).padStart(2, '0')})</span></h2>
    <a class="all" href={localePath(lang, '/archive/')}>
      <span data-scramble>{t(lang, 'index.all')}</span> <span class="muted">({ARCHIVE_TOTAL})</span> →
    </a>
  </div>

  <ol class="rows">
    {
      selected.map((p, i) => (
        <li>
          <a class="row grid" href={localePath(lang, `/projects/${p.slug}/`)}>
            <span class="r-num mono muted">{String(i + 1).padStart(3, '0')}</span>
            <span class="r-title" data-scramble>{p.title[lang]}</span>
            <span class="r-type mono">{p.type[lang]}</span>
            <span class="r-year mono">{p.year}</span>
            <Image class="r-preview" src={p.cover} alt="" width={720} widths={[360, 720]} sizes="320px" loading="lazy" />
          </a>
        </li>
      ))
    }
  </ol>
</section>

<script>
  // превью проекта следует за курсором; угол наклона у каждого свой — небольшой беспорядок
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  if (fine) {
    document.querySelectorAll<HTMLElement>('.row').forEach((row) => {
      const img = row.querySelector<HTMLElement>('.r-preview');
      if (!img) return;
      img.style.setProperty('--tilt', `${(Math.random() * 6 - 3).toFixed(2)}deg`);
      row.addEventListener('mousemove', (e) => {
        img.style.setProperty('--x', `${e.clientX}px`);
        img.style.setProperty('--y', `${e.clientY}px`);
      });
    });
  }
</script>

<style>
  /* ——— первый экран ——— */
  .hero {
    position: relative;
    min-height: calc(100svh - 72px);
    grid-template-rows: auto 1fr auto auto;
    padding-top: var(--s5);
    padding-bottom: var(--s5);
  }

  .meta {
    grid-column: 1 / span 3;
  }

  .clock {
    grid-column: var(--col) / span 3;
  }

  .clock time {
    font-variant-numeric: tabular-nums;
  }

  .school {
    grid-column: 10 / span 3;
  }

  /* имя: антиква, статично. Фамилия начинается с главной оси (4-я колонка) */
  .name-block {
    grid-column: 1 / -1;
    grid-row: 3;
    display: grid;
    grid-template-columns: subgrid;
    margin-top: var(--s5);
  }

  .name {
    display: contents;
  }

  .line {
    font-family: var(--f-serif);
    font-weight: 400;
    font-size: clamp(72px, 15.5vw, 300px);
    line-height: 0.86;
    letter-spacing: -0.025em;
  }

  .line-1 {
    grid-column: 1 / -1;
    grid-row: 1;
  }

  .line-2 {
    grid-column: 4 / -1;
    grid-row: 2;
  }

  /* «дизайнер»: грубый узкий гротеск — контраст к шёлку антиквы */
  .role {
    grid-column: 10 / -1;
    grid-row: 1;
    align-self: end;
    padding-bottom: 0.9vw;
    font-family: var(--f-display);
    font-weight: 800;
    font-size: clamp(26px, 2.85vw, 56px);
    line-height: 0.88;
    text-transform: uppercase;
    letter-spacing: -0.005em;
    color: var(--ink);
  }

  .lead {
    grid-column: 4 / span 4;
    grid-row: 4;
    margin-top: var(--s5);
  }

  .lead em {
    font-size: 1.2em;
    line-height: 1;
  }

  /* заметка «на полях»: стоит на второй оси, но чуть повёрнута */
  .note {
    grid-column: 10 / span 3;
    grid-row: 4;
    align-self: end;
    color: var(--graphite);
    transform: rotate(-1.5deg);
    transform-origin: left bottom;
  }

  .reg {
    position: absolute;
    width: 16px;
    height: 16px;
    pointer-events: none;
  }

  .reg::before,
  .reg::after {
    content: '';
    position: absolute;
    background: var(--ink);
  }

  .reg::before {
    left: 50%;
    top: 0;
    width: 1px;
    height: 100%;
  }

  .reg::after {
    top: 50%;
    left: 0;
    height: 1px;
    width: 100%;
  }

  .reg-tl {
    top: var(--s3);
    left: calc(var(--margin) - 8px);
  }

  .reg-br {
    bottom: var(--s3);
    right: calc(var(--margin) - 8px);
  }

  /* ——— избранное ——— */
  .index {
    margin-top: var(--s6);
  }

  .index-head {
    padding-bottom: var(--s1);
  }

  .index-head h2 {
    grid-column: 1 / span 3;
    margin: 0;
    font: inherit;
  }

  .all {
    grid-column: 10 / span 3;
  }

  .all:hover [data-scramble] {
    border-bottom: 1px solid var(--ink);
  }

  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  .rows li {
    border-bottom: 1px solid var(--hair);
  }

  .row {
    align-items: baseline;
    padding-block: var(--s2);
    transition: background-color 0.35s var(--ease);
  }

  .r-num {
    grid-column: 1 / span 3;
  }

  .r-title {
    grid-column: 4 / span 6;
    font-size: var(--t-title);
    line-height: var(--lh-title);
    letter-spacing: -0.015em;
    transition: transform 0.45s var(--ease);
  }

  .r-type {
    grid-column: 10 / span 2;
    color: var(--graphite);
  }

  .r-year {
    grid-column: 12 / span 1;
    justify-self: end;
  }

  .row:hover {
    background-color: var(--paper-deep);
  }

  .row:hover .r-title {
    transform: translateX(var(--s2));
  }

  .r-preview {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 20;
    width: 320px;
    height: auto;
    pointer-events: none;
    opacity: 0;
    transform: translate(calc(var(--x, 0px) + 24px), calc(var(--y, 0px) - 50%)) rotate(var(--tilt, 0deg));
    transition: opacity 0.25s var(--ease);
    box-shadow: 0 18px 40px -24px rgba(0, 0, 0, 0.35);
  }

  .row:hover .r-preview {
    opacity: 1;
  }

  @media (hover: none), (pointer: coarse) {
    .r-preview {
      display: none;
    }
  }

  /* ——— телефон: 6 колонок, ось — 2-я колонка ——— */
  @media (max-width: 800px) {
    .hero {
      min-height: auto;
      grid-template-rows: auto;
      row-gap: var(--s3);
      padding-top: var(--s4);
    }
    .meta {
      grid-column: 1 / span 3;
    }
    .school {
      grid-column: 4 / span 3;
      grid-row: 1;
    }
    .clock {
      grid-column: auto / span 3;
      grid-row: 2;
    }
    .clock:first-of-type {
      grid-column: 1 / span 3;
    }
    .name-block {
      grid-row: auto;
      margin-top: var(--s4);
    }
    .line {
      font-size: 19vw;
    }
    .line-2 {
      grid-column: 2 / -1;
    }
    .role {
      grid-column: 2 / -1;
      grid-row: 3;
      margin-top: var(--s2);
      padding: 0;
      font-size: 36px;
    }
    .lead {
      grid-column: 1 / -1;
      grid-row: auto;
      margin-top: var(--s2);
    }
    .note {
      grid-column: 2 / -1;
      grid-row: auto;
    }
    .index {
      margin-top: var(--s5);
    }
    .index-head h2 {
      grid-column: 1 / span 3;
    }
    .all {
      grid-column: 1 / -1;
    }
    .r-num {
      grid-column: 1 / span 1;
    }
    .r-title {
      grid-column: 2 / -1;
    }
    .r-type {
      grid-column: 2 / span 4;
      margin-top: var(--s1);
    }
    .r-year {
      grid-column: 6 / span 1;
    }
    .row:hover .r-title {
      transform: none;
    }
  }
</style>
