---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const contacts = [
  { label: 'E-mail', value: 'butusovakaterinav@yandex.ru', href: 'mailto:butusovakaterinav@yandex.ru', col: 4 },
  { label: 'Telegram', value: '@kzaraza', href: 'https://t.me/kzaraza', col: 7 },
];
---

<footer class="footer grid mono">
  <p class="label">{t(lang, 'footer.contact')}</p>
  {
    contacts.map((c) => (
      <p class="contact" style={`--col:${c.col}`}>
        <span class="muted">{c.label}</span>
        <br />
        <a href={c.href}>
          <span data-scramble>{c.value}</span>
        </a>
      </p>
    ))
  }
  <p class="copy muted">© 2026<br />Katerina Butusova</p>
</footer>

<style>
  .footer {
    margin-top: var(--s7);
    padding-block: var(--s2) var(--s4);
    border-top: 1px solid var(--ids__border);
  }

  .label {
    grid-column: 1 / span 3;
  }

  .contact {
    grid-column: var(--col) / span 3;
  }

  .contact a {
    text-transform: none;
    border-bottom: 1px solid var(--ids__border);
    transition: border-color 0.3s var(--ease);
  }

  .contact a:hover {
    border-color: var(--ids__text);
  }

  .copy {
    grid-column: 10 / span 3;
  }

  @media (max-width: 800px) {
    .footer {
      row-gap: var(--s3);
    }
    .label {
      grid-column: 1 / -1;
    }
    .contact {
      grid-column: 1 / -1;
    }
    .copy {
      grid-column: 1 / -1;
    }
  }
</style>
